# JobSpy fork — API-source credentials.
# Copy this file to `.env` and fill in your keys. `.env` is gitignored;
# never commit real keys.
#
# Each link below is the registration page. All five are free-tier as of
# 2026-05-05.

# ─── Adzuna ──────────────────────────────────────────────────────────
# Large free aggregator (~250 calls/month free tier). 100% salary fill.
# Register: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ─── USAJobs.gov ─────────────────────────────────────────────────────
# Federal jobs only. Email is sent as User-Agent per their ToS.
# Register: https://developer.usajobs.gov/apirequest/
USAJOBS_USER_AGENT_EMAIL=
USAJOBS_API_KEY=

# ─── Jooble ──────────────────────────────────────────────────────────
# International aggregator. Heavy overlap with Indeed for US queries
# but unique for European/Asian regional listings.
# Register: https://jooble.org/api/about
JOOBLE_API_KEY=

# ─── Findwork ────────────────────────────────────────────────────────
# Dev-focused board (SRE / startup / direct-employer postings).
# Register: https://findwork.dev/developers/
FINDWORK_API_KEY=

# ─── The Muse ────────────────────────────────────────────────────────
# Curated mid/large tech company-direct postings. Optional — read
# endpoints work without a key but a key raises rate limits.
# Register: https://www.themuse.com/developers/api/v2
THE_MUSE_API_KEY=
